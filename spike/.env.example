# ── LiveKit Cloud (required) ──────────────────────────────────────────
# Create a FREE "Build" project at https://cloud.livekit.io (no credit card).
# In the project's Settings → Keys, create an API key. You'll get all three:
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Deepgram (required for Stage 2 server-side transcription) ──────────
# Free $200 credit, no card, at https://console.deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local web server port
PORT=3000
