; @supabase/supabase-js's realtime client needs a native WebSocket global,
; only present in Node 22+. On Node 20 the server boots fine and only fails
; on the first DB-backed request, not at startup -- see LESSONS.md's
; Node.js entry. engine-strict turns that into a loud `npm install` failure
; instead of a silent one at runtime.
engine-strict=true
