# Local web server port
PORT=3000

# ── Supabase (ADR-0003/0004) — needed starting W2 ──────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The publishable/anon key. Only test/historyRlsIsolation.test.js needs it
# (it signs in as real users to prove RLS isolation through Postgres, not
# through the service-role client the app uses). Without it that test
# silently skips instead of failing.
SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LiveKit Cloud (ADR-0001) — needed starting W3 ───────────────────────
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AssemblyAI (ADR-0002) — needed starting W5 ──────────────────────────
ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Gemini (ADR-0008) — needed starting W4/W6 ────────────────────
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the model (defaults to gemini-3.6-flash — see
# src/llm/geminiClient.js for why gemini-2.5-flash, ADR-0008's original
# pick, was swapped at build time).
GEMINI_MODEL=gemini-3.6-flash
