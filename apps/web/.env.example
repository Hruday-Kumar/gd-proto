# ── Supabase (ADR-0003) ──────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard. The anon/publishable
# key is safe to expose client-side — that's what it's for.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# apps/server's local URL
VITE_API_URL=http://localhost:3000

# ── PostHog (B2, pilot-readiness audit) — optional, unset by default ────
# Pre-signup/pre-consent funnel events the database can't see (lib/
# analytics.js). Everything no-ops with these unset; there's no need for a
# PostHog account until it's actually time to watch the funnel. Free tier:
# https://posthog.com/pricing. Review whether ConsentPage.jsx's disclosures
# need a line about behavioural analytics before setting this in a real
# deployment -- see the comment in lib/analytics.js.
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
